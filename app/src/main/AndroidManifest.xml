<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Local network only: mDNS browsing plus a TCP socket to the Apple TV. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Every button confirms itself with a 45ms tick on finger-down, which is the whole point
      on a remote: your eyes are on the television, not on the phone. Without this permission
      Vibrator.vibrate throws a SecurityException that the haptic helper swallows, so the
      buttons stay silent and nothing anywhere says why.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
      Android 13+ gates mDNS discovery behind NEARBY_WIFI_DEVICES. neverForLocation is set
      because this is service discovery, not positioning, and without it the permission
      would imply a location grant the app never uses.
    -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Apple TV"
        android:supportsRtl="true"
        android:theme="@style/Theme.LightRemote">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Apple TV"
            android:theme="@style/Theme.LightRemote"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            LightSync finds apps by provider authority suffix, so this entry is the whole
            registration. exported=true is required for a cross-app ContentProvider and is not
            the trust boundary: LightSyncBackup rejects any caller that is not LightSync by
            package and by signing certificate, checked on every call.
        -->
        <provider
            android:name=".backup.Backup"
            android:authorities="${applicationId}.lightsync.backup"
            android:exported="true" />
    </application>
</manifest>
