<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Local network only: mDNS browsing plus a TCP socket to the Apple TV. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Every button confirms itself with a 45ms tick on finger-down, which is the whole point
      on a remote: your eyes are on the television, not on the phone. Without this permission
      Vibrator.vibrate throws a SecurityException that the haptic helper swallows, so the
      buttons stay silent and nothing anywhere says why.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
      Android 13+ gates mDNS discovery behind NEARBY_WIFI_DEVICES. neverForLocation is set
      because this is service discovery, not positioning, and without it the permission
      would imply a location grant the app never uses.
    -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!--
      Background activity launch. Waking the phone delivers ACTION_SCREEN_ON to a receiver in
      a process with nothing on screen, and starting an activity from there has been blocked
      since Android 10; holding "Display over other apps" is the exemption that makes the
      relaunch land. It is requested from the Stay open setting, not at launch, and the
      feature is off until it is granted — the app draws no overlays and never has.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".LightRemoteApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Apple TV"
        android:supportsRtl="true"
        android:theme="@style/Theme.LightRemote">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Apple TV"
            android:theme="@style/Theme.LightRemote"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
