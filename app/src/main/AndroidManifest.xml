<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Local network only: mDNS browsing plus a TCP socket to the Apple TV. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Every button confirms itself with a 45ms tick on finger-down, which is the whole point
      on a remote: your eyes are on the television, not on the phone. Without this permission
      Vibrator.vibrate throws a SecurityException that the haptic helper swallows, so the
      buttons stay silent and nothing anywhere says why.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
      Android 13+ gates mDNS discovery behind NEARBY_WIFI_DEVICES. neverForLocation is set
      because this is service discovery, not positioning, and without it the permission
      would imply a location grant the app never uses.
    -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <!--
      Wi-Fi hardware drops multicast frames not addressed to it, so the radio can sleep. mDNS is
      multicast, so a browse held without a MulticastLock can start cleanly, report no error, and
      never hear a single reply. Normal protection level: granted at install, no dialog.
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
      The foreground service that keeps the process alive while the screen is off so the
      Companion socket and the media session survive. connectedDevice is the right type for a
      long-lived link to a device on the network, and it is satisfiable here by the Wi-Fi
      permissions already held (CHANGE_WIFI_MULTICAST_STATE is on the type's allow-list).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- POST_NOTIFICATIONS on 13+: the LOW ongoing "Connected to <name>" line. Not fatal if
         denied — the service still runs, the notification is simply not shown. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Apple TV"
        android:supportsRtl="true"
        android:theme="@style/Theme.LightRemote">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Apple TV"
            android:theme="@style/Theme.LightRemote"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
            Keeps the process — and with it the Companion socket and the media session — alive
            while the screen is off. Not exported: nothing outside the app starts it.
        -->
        <service
            android:name=".service.RemoteService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!--
            LightSync finds apps by provider authority suffix, so this entry is the whole
            registration. exported=true is required for a cross-app ContentProvider and is not
            the trust boundary: LightSyncBackup rejects any caller that is not LightSync by
            package and by signing certificate, checked on every call.
        -->
        <provider
            android:name=".backup.Backup"
            android:authorities="${applicationId}.lightsync.backup"
            android:exported="true" />

        <!--
            Viewing sessions for the LightNotebook journal bus. Exported because the journal
            reads it from another app; read-only because it throws on every write; and safe
            to expose because the only thing behind it is "what played on the Apple TV and
            for how long", which the querying side is the whole point of.
        -->
        <provider
            android:name=".watched.WatchedProvider"
            android:authorities="com.gios.lightremote.watched"
            android:exported="true" />
    </application>
</manifest>
